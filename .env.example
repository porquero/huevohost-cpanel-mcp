# Copia estos nombres en tus variables de entorno del sistema.
# No guardes secretos reales en este archivo ni en el repositorio.

CPANEL_HOST=cpanel.example.com
CPANEL_USER=usuario
CPANEL_TOKEN=

# Opcionales
CPANEL_PORT=2083
CPANEL_VERIFY_SSL=true
MCP_FILE_MAX_BYTES=1048576
